{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "none" },
  "display": {
    "separator": "  ",
    "key": { "width": 24 },
    "color": { "keys": "#7a7a85", "output": "#e8e8ec" },
    "brightColor": false
  },
  "modules": [
    { "type": "custom", "format": "\u001b[38;2;204;21;21m ┌──────────────────────────────────────────┐ \u001b[0m" },
    { "type": "custom", "format": "\u001b[38;2;204;21;21m │ \u001b[0m\u001b[1;38;2;232;232;236m SHADOWX \u001b[0m\u001b[38;2;204;21;21m // \u001b[0m\u001b[38;2;122;122;133mNOIR\u001b[0m                         \u001b[38;2;204;21;21m│ \u001b[0m" },
    { "type": "custom", "format": "\u001b[38;2;204;21;21m └──────────────────────────────────────────┘ \u001b[0m" },
    "break",
    { "type": "os", "key": "  OS", "format": "{name} {version}" },
    { "type": "kernel", "key": "  KERNEL", "format": "{release}" },
    { "type": "shell", "key": "  SHELL", "format": "{name} {version}" },
    { "type": "wm", "key": "  WM", "format": "{pretty-name}" },
    { "type": "terminal", "key": "  TERM", "format": "{pretty-name}" },
    "break",
    { "type": "cpu", "key": "  CPU", "format": "{name} · {cores-physical}C/{cores-logical}T" },
    { "type": "memory", "key": "  MEMORY", "format": "{used} / {total} ({percentage})" },
    { "type": "disk", "key": "  DISK", "folders": ["/"], "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "uptime", "key": "  UPTIME", "format": "{hours}h {minutes}m" },
    "break",
    { "type": "custom", "format": "\u001b[38;2;204;21;21m // SHADOWX — OWN YOUR DESKTOP \u001b[0m" }
  ]
}
