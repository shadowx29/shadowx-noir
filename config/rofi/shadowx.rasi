/* SHADOWX // NOIR — launcher theme, written from scratch. */
* {
  font: "JetBrainsMono Nerd Font 12";
  base: #0a0a0c;
  panel: #101014;
  text: #e8e8ec;
  faint: #7a7a85;
  red: #cc1515;
  edge: #26262e;
}

window {
  background-color: @base;
  border: 1px solid @red;
  width: 640px;
  location: north;
  anchor: center;
  y-offset: 14%;
}

inputbar {
  children: [prompt, entry];
  padding: 14px 18px;
  spacing: 14px;
  background-color: @panel;
  border-bottom: 1px solid @edge;
}

prompt {
  text: "[SHADOWX]";
  color: @red;
  font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
  placeholder: "type to search...";
  color: @text;
  placeholder-color: @faint;
  caret-color: @red;
}

listview {
  lines: 8;
  columns: 1;
  spacing: 2px;
  padding: 10px 10px 14px;
  background-color: @base;
}

element {
  padding: 7px 14px;
  color: @faint;
  background-color: transparent;
}

element selected {
  color: @text;
  background-color: rgba(204, 21, 21, 0.18);
  border-left: 3px solid @red;
}

scrollbar { width: 5px; background-color: @base; }
scrollbar thumb { background-color: @red; }

message { padding: 12px; color: @text; background-color: @panel; border: 1px solid @edge; }
error-message { padding: 12px; color: @text; background-color: @red; }
