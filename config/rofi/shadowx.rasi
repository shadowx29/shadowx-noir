/* SHADOWX // NOIR — rofi 2.0 launcher theme. */
* {
  font: "JetBrainsMono Nerd Font 12";
  base: #0a0a0c;
  panel: #101014;
  txt: #e8e8ec;
  faint: #7a7a85;
  red: #cc1515;
  edge: #26262e;
}

window {
  background-color: @base;
  border: 1px;
  border-color: @red;
  border-radius: 0;
  width: 640px;
  location: center;
  anchor: center;
}

inputbar {
  children: [prompt, entry];
  padding: 14px 18px;
  spacing: 14px;
  background-color: @panel;
  border: 0;
}

prompt {
  text: "[SHADOWX]";
  text-color: @red;
  font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
  placeholder: "type to search...";
  text-color: @txt;
  placeholder-color: @faint;
  background-color: @panel;
  padding: 0;
  border: 0;
}

listview {
  lines: 8;
  columns: 1;
  spacing: 2px;
  padding: 10px 10px 14px;
  background-color: @base;
  border: 0;
}

element {
  padding: 7px 14px;
  border: 0;
  border-radius: 0;
}

element normal.normal {
  background-color: @panel;
  text-color: @faint;
}

element normal.urgent {
  background-color: @base;
  text-color: @red;
}

element normal.active {
  background-color: @base;
  text-color: @txt;
}

element selected.normal {
  background-color: @red;
  text-color: @base;
}

element selected.urgent {
  background-color: @red;
  text-color: @base;
}

element selected.active {
  background-color: @red;
  text-color: @base;
}

element alternate.normal {
  background-color: @panel;
  text-color: @faint;
}

element alternate.selected {
  background-color: @red;
  text-color: @base;
}

element-text {
  background-color: transparent;
  text-color: inherit;
  vertical-align: 0.5;
}

scrollbar {
  width: 5px;
  background-color: @base;
  border: 0;
}

scrollbar thumb {
  background-color: @red;
  border: 0;
}

message {
  padding: 12px;
  text-color: @txt;
  background-color: @panel;
  border: 1px;
  border-color: @edge;
}
