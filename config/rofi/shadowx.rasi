/* SHADOWX // NOIR — launcher theme, written from scratch. */
* {
  font: "JetBrainsMono Nerd Font 12";
  base: #0a0a0c;
  panel: #101014;
  txt: #e8e8ec;
  faint: #7a7a85;
  red: #cc1515;
  edge: #26262e;
}

window {
  background-color: @base;
  border: 1px;
  border-color: @red;
  border-radius: 0;
  width: 640px;
  location: north;
  anchor: center;
  y-offset: 14%;
}

inputbar {
  children: [prompt, entry];
  padding: 14px 18px;
  spacing: 14px;
  background-color: @panel;
  border: 0px;
}

prompt {
  text: "[SHADOWX]";
  color: @red;
  font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
  placeholder: "type to search...";
  color: @txt;
  placeholder-color: @faint;
  caret-color: @red;
  background-color: @panel;
  padding: 0px;
  border: 0px;
}

listview {
  lines: 8;
  columns: 1;
  spacing: 2px;
  padding: 10px 10px 14px;
  background-color: @base;
  border: 0px;
}

element {
  padding: 7px 14px;
  color: @faint;
  background-color: @base;
  border: 0px;
  border-radius: 0;
}

element selected {
  color: @txt;
  background-color: rgba(204, 21, 21, 0.18);
  border: 0px;
  border-left: 3px;
  border-color: @red;
}

element-text {
  vertical-align: 0.5;
}

scrollbar {
  width: 5px;
  background-color: @base;
  border: 0px;
}

scrollbar thumb {
  background-color: @red;
  border: 0px;
}

message {
  padding: 12px;
  color: @txt;
  background-color: @panel;
  border: 1px;
  border-color: @edge;
}
